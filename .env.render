# Render Deployment Configuration
NODE_ENV=production
APP_PORT=3000
APP_HOST=0.0.0.0

# Database - Will be provided by Render
# DATABASE_URL=your_neon_connection_string

# JWT - Change these in production!
JWT_SECRET=your_secure_jwt_secret_key_here_change_in_render_dashboard
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your_secure_refresh_key_here_change_in_render_dashboard
JWT_REFRESH_EXPIRATION=7d

# CORS - Allow all origins (can be restricted later)
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
