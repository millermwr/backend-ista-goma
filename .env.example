# Application
NODE_ENV=development
APP_PORT=3000
APP_HOST=localhost
API_VERSION=v1

# Database - Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-XXXXX.neon.tech/academicdb?sslmode=require
DB_HOST=ep-XXXXX.neon.tech
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=academicdb
DB_SSL=true

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your_super_secret_refresh_key
JWT_REFRESH_EXPIRATION=7d

# Email (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# SMS (optional - Twilio or local provider)
SMS_PROVIDER=twilio
SMS_API_KEY=your_api_key
SMS_API_SECRET=your_api_secret

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:8080

# Logging
LOG_LEVEL=debug
